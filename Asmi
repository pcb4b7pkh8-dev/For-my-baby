

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">

<meta name="theme-color" content="#17132f">

<title>To My Starlight ♡</title>

<style>

:root{

--night:#17132f;

--lav:#c9b7ff;

--pink:#f3c7e7;

--white:#fff8ff;

--muted:#c9c0e7;

}

*{box-sizing:border-box}

html{

scroll-behavior:smooth;

background:var(--night);

}

body{

margin:0;

min-height:100%;

background:var(--night);

color:var(--white);

font-family:Georgia,"Times New Roman",serif;

overflow-x:hidden;

}

button{font:inherit}

/* GALAXY BACKGROUND */

.sky{

position:fixed;

inset:0;

z-index:0;

overflow:hidden;

pointer-events:none;

background:radial-gradient(

ellipse at 50% 110%,

#514078 0%,

#292044 42%,

#17132f 78%

);

}

#stars{

position:absolute;

inset:0;

width:100%;

height:100%;

}

.nebula{

position:absolute;

width:65vw;

height:65vw;

max-width:700px;

max-height:700px;

border-radius:50%;

filter:blur(70px);

opacity:.14;

animation:drift 18s ease-in-out infinite alternate;

}

.nebula.one{

background:#c6a0ff;

left:-20%;

top:10%;

}

.nebula.two{

background:#f29bce;

right:-25%;

bottom:-20%;

animation-delay:-8s;

}

@keyframes drift{

to{transform:translate(12vw,-8vh) scale(1.25)}

}

.shooting{

position:absolute;

width:130px;

height:1px;

background:linear-gradient(

90deg,transparent,#fff,#d9c7ff,transparent

);

transform:rotate(-28deg);

opacity:0;

animation:shoot 7s linear infinite;

}

@keyframes shoot{

0%,75%{

opacity:0;

transform:translate(0,0) rotate(-28deg);

}

78%{opacity:1}

88%{

opacity:0;

transform:translate(-230px,115px) rotate(-28deg);

}

100%{opacity:0}

}

/* HEADER */

.topbar{

position:fixed;

z-index:20;

top:0;

left:0;

right:0;

display:flex;

justify-content:space-between;

align-items:center;

padding:14px 18px;

padding-top:max(14px,env(safe-area-inset-top));

background:#17132fb8;

backdrop-filter:blur(14px);

border-bottom:1px solid #ffffff18;

}

.brand{

color:var(--pink);

font-size:16px;

}

.count{

font:12px Arial,sans-serif;

color:var(--muted);

letter-spacing:1px;

}

/* PAGES */

.page{

display:none;

position:relative;

z-index:1;

min-height:100svh;

padding:90px 20px 110px;

align-items:center;

justify-content:center;

}

.page.active{

display:flex;

animation:fade .7s ease both;

}

@keyframes fade{

from{opacity:0;transform:translateY(14px)}

to{opacity:1;transform:none}

}

.content{

width:min(790px,100%);

text-align:center;

margin:auto;

}

.eyebrow{

font:700 10px Arial,sans-serif;

letter-spacing:3px;

text-transform:uppercase;

color:var(--lav);

}

h1{

font-size:clamp(43px,10vw,82px);

font-weight:400;

line-height:1.02;

color:#fff3ff;

margin:18px 0;

text-shadow:0 0 30px #d5baff55;

}

h2{

font-size:clamp(32px,7vw,55px);

font-weight:400;

line-height:1.1;

color:#f0ddff;

margin:14px 0 18px;

}

p{

font-size:clamp(16px,3.6vw,20px);

line-height:1.75;

color:#e5dcf8;

max-width:650px;

margin:14px auto;

}

.muted{

font:12px Arial,sans-serif;

letter-spacing:1px;

color:#b9aed9;

}

/* BUTTONS */

.btn{

border:1px solid #ffffff28;

border-radius:999px;

padding:13px 22px;

background:linear-gradient(135deg,#b79aff,#8b72c8);

color:white;

box-shadow:0 8px 28px #9a7de633;

cursor:pointer;

margin:8px 5px;

transition:.22s;

}

.btn:hover{

transform:translateY(-3px);

filter:brightness(1.1);

}

.btn.ghost{

background:#ffffff0c;

color:#f1e7ff;

}

/* GLASS CARDS */

.glass{

background:linear-gradient(145deg,#ffffff14,#ffffff08);

border:1px solid #ffffff25;

border-radius:26px;

padding:24px;

box-shadow:0 20px 70px #08061655;

backdrop-filter:blur(12px);

max-width:660px;

margin:18px auto;

}

/* FLOATING ICONS */

.orb{

font-size:clamp(58px,14vw,105px);

display:inline-block;

filter:drop-shadow(0 0 22px #d6baff77);

animation:float 4s ease-in-out infinite;

}

@keyframes float{

50%{transform:translateY(-12px) rotate(4deg)}

}

/* GAME GRID */

.grid{

display:grid;

grid-template-columns:repeat(2,minmax(0,1fr));

gap:12px;

max-width:650px;

margin:22px auto;

}

.choice{

border:1px solid #ffffff25;

background:#ffffff0d;

color:#f9efff;

border-radius:20px;

padding:18px 10px;

cursor:pointer;

line-height:1.5;

transition:.2s;

}

.choice:hover,.choice:focus{

background:#c2a8ff2b;

transform:translateY(-3px);

outline:none;

}

.choice b{

display:block;

font-size:28px;

margin-bottom:6px;

}

/* NAVIGATION */

.navbottom{

position:fixed;

z-index:20;

bottom:0;

left:0;

right:0;

padding:12px 16px max(15px,env(safe-area-inset-bottom));

display:flex;

align-items:center;

justify-content:center;

gap:7px;

background:linear-gradient(0deg,#17132fee,#17132f00);

}

.dot{

width:7px;

height:7px;

border:0;

border-radius:20px;

background:#ffffff48;

padding:0;

cursor:pointer;

}

.dot.active{

width:23px;

background:#d8c5ff;

}

/* PHOTO GALLERY */

.photo-grid{

display:grid;

grid-template-columns:repeat(3,minmax(0,1fr));

gap:12px;

margin:22px auto;

max-width:690px;

}

.photo{

min-width:0;

background:#fff;

padding:8px 8px 28px;

border-radius:5px;

box-shadow:0 10px 30px #08061666;

transform:rotate(-2deg);

color:#4c3b64;

position:relative;

}

.photo:nth-child(2){

transform:rotate(2.5deg) translateY(12px);

}

.photo:nth-child(3){

transform:rotate(-1deg) translateY(-5px);

}

.photo img{

width:100%;

aspect-ratio:3/4;

object-fit:cover;

display:block;

background:linear-gradient(145deg,#e9ddff,#f7dff0);

}

.photo label{

display:block;

font:12px Georgia,serif;

padding-top:8px;

cursor:pointer;

}

.photo input{display:none}

.photo .placeholder{

aspect-ratio:3/4;

display:flex;

align-items:center;

justify-content:center;

flex-direction:column;

background:linear-gradient(145deg,#e7dcff,#f8dff0);

color:#695783;

font-size:30px;

}

.photo .placeholder small{

font:10px Arial,sans-serif;

margin-top:8px;

letter-spacing:1px;

}

.caption{

font:11px Arial,sans-serif;

color:#d2c6eb;

margin-top:8px;

}

/* GAME PROGRESS */

.progress{

height:7px;

border-radius:10px;

background:#ffffff20;

overflow:hidden;

margin:14px auto;

max-width:340px;

}

.progress span{

display:block;

height:100%;

width:0;

background:linear-gradient(90deg,#e5c7ff,#ffcae8);

transition:width .3s;

}

/* SECRET MESSAGE */

.scratchbox{

max-width:480px;

margin:20px auto;

padding:25px;

border-radius:22px;

background:#ffffff12;

border:1px solid #ffffff30;

cursor:pointer;

user-select:none;

}

.scratchbox .hiddenmessage{

display:none;

color:#ffe6f6;

font-size:21px;

line-height:1.65;

}

.scratchbox.revealed .cover{display:none}

.scratchbox.revealed .hiddenmessage{display:block}

/* FLOATING HEARTS */

#heartfield{

position:fixed;

inset:0;

pointer-events:none;

z-index:30;

overflow:hidden;

}

.floaty{

position:absolute;

bottom:-30px;

animation:rise 5s linear forwards;

font-size:20px;

}

@keyframes rise{

to{

transform:translateY(-110vh) rotate(35deg);

opacity:0;

}

}

footer{

font:11px Arial,sans-serif;

color:#a99bc9;

margin-top:24px;

}

/* HEART GAME */

#catchArea{

height:250px;

max-width:520px;

margin:18px auto;

position:relative;

overflow:hidden;

border:1px solid #ffffff25;

border-radius:22px;

background:#ffffff0b;

}

.catch{

position:absolute;

border:0;

background:transparent;

font-size:31px;

cursor:pointer;

animation:bob 1.8s ease-in-out infinite alternate;

padding:8px;

touch-action:manipulation;

}

@keyframes bob{

to{transform:translateY(-8px) rotate(12deg)}

}

/* FINAL LETTER */

#secret{display:none}

.secret-open #secret{

display:block;

animation:fade .7s ease;

}

/* MUSIC */

.music{

position:fixed;

z-index:25;

right:14px;

bottom:67px;

border:1px solid #ffffff30;

background:#251e45;

color:#f7eaff;

border-radius:30px;

padding:10px 13px;

font:11px Arial,sans-serif;

cursor:pointer;

}

/* MOBILE */

@media(max-width:520px){

.photo-grid{gap:7px}

.photo{padding:5px 5px 22px}

.photo label{font-size:10px}

.glass{padding:20px 16px}

.page{

padding-left:16px;

padding-right:16px;

}

}

@media(prefers-reduced-motion:reduce){

*,*::before,*::after{

animation-duration:.01ms!important;

animation-iteration-count:1!important;

scroll-behavior:auto!important;

}

}

</style>

</head>

