<script>

"use strict";

/* STARFIELD */

const canvas=document.getElementById("stars");

const ctx=canvas.getContext("2d");

let stars=[];

function sizeSky(){

const dpr=Math.min(window.devicePixelRatio||1,2);

canvas.width=Math.floor(innerWidth*dpr);

canvas.height=Math.floor(innerHeight*dpr);

ctx.setTransform(dpr,0,0,dpr,0,0);

stars=Array.from({

length:Math.min(150,Math.floor(innerWidth/5))

},()=>({

x:Math.random()*innerWidth,

y:Math.random()*innerHeight,

r:Math.random()*1.5+.3,

a:Math.random(),

s:Math.random()*.012+.003

}));

}

function drawSky(){

ctx.clearRect(0,0,innerWidth,innerHeight);

for(const s of stars){

s.a+=s.s;

if(s.a>1||s.a<.15){

s.s*=-1;

}

ctx.beginPath();

ctx.arc(s.x,s.y,s.r,0,Math.PI*2);

ctx.fillStyle=`rgba(255,245,255,${s.a})`;

ctx.fill();

}

requestAnimationFrame(drawSky);

}

addEventListener("resize",sizeSky);

sizeSky();

drawSky();

/* PAGE NAVIGATION */

const pages=[...document.querySelectorAll(".page")];

const dots=document.getElementById("dots");

let current=0;

pages.forEach((_,i)=>{

const d=document.createElement("button");

d.className="dot"+(!i?" active":"");

d.type="button";

d.title="Page "+(i+1);

d.setAttribute(

"aria-label",

"Go to page "+(i+1)

);

d.addEventListener("click",()=>go(i));

dots.appendChild(d);

});

function go(i){

current=Math.max(

0,

Math.min(pages.length-1,i)

);

pages.forEach((p,n)=>{

p.classList.toggle("active",n===current);

});

[...dots.children].forEach((d,n)=>{

d.classList.toggle("active",n===current);

});

document.getElementById("count").textContent=

String(current+1).padStart(2,"0")+" / 08";

window.scrollTo({

top:0,

behavior:"smooth"

});

}

document.addEventListener("keydown",e=>{

if(e.key==="ArrowRight")go(current+1);

if(e.key==="ArrowLeft")go(current-1);

});

/* PHOTO GALLERY */

const photoUrls=[];

function loadPhoto(e,n){

const file=e.target.files&&e.target.files[0];

if(!file)return;

if(!file.type.startsWith("image/")){

alert("Please choose an image file.");

return;

}

if(photoUrls[n]){

URL.revokeObjectURL(photoUrls[n]);

}

const url=URL.createObjectURL(file);

photoUrls[n]=url;

const img=document.getElementById("img"+n);

img.src=url;

img.style.display="block";

document.getElementById("ph"+n).style.display="none";

}

/* HEART CATCHING GAME */

let score=0;

let heartTimer=null;

const heartSymbols=[

"💜","💗","💕","✨","💖","🌟","🩷"

];

function spawnCatchHeart(){

const area=document.getElementById("catchArea");

if(score>=7)return;

const heart=document.createElement("button");

heart.className="catch";

heart.type="button";

heart.textContent=

heartSymbols[

Math.floor(Math.random()*heartSymbols.length)

];

heart.style.left=(8+Math.random()*78)+"%";

heart.style.top=(8+Math.random()*70)+"%";

heart.setAttribute(

"aria-label",

"Collect this wish"

);

heart.addEventListener(

"click",

()=>catchHeart(heart)

);

area.appendChild(heart);

}

function catchHeart(el){

if(score>=7||!el.isConnected)return;

el.remove();

score++;

document.getElementById("score").textContent=

score+" / 7";

document.getElementById("bar").style.width=

(score/7*100)+"%";

if(score>=7){

clearTimeout(heartTimer);

document.getElementById("catchArea").innerHTML="";

document.getElementById("gameMsg").textContent=

"Seven wishes collected! 👀💜✨";

burst();

}else{

document.getElementById("gameMsg").textContent=

"Another little wish is waiting for you! 💗";

heartTimer=setTimeout(spawnCatchHeart,350);

}

}

function resetGame(){

clearTimeout(heartTimer);

score=0;

document.getElementById("score").textContent="0 / 7";

document.getElementById("bar").style.width="0%";

document.getElementById("gameMsg").textContent=

"Ready when you are, princess. Collect all seven wishes!";

document.getElementById("catchArea").innerHTML="";

spawnCatchHeart();

}

spawnCatchHeart();

/* PERSONALITY GAME */

function royal(title,desc){

const box=document.getElementById("royalResult");

box.replaceChildren();

const heading=document.createElement("div");

heading.style.cssText=

"font-size:26px;color:#f5dfff";

heading.textContent=title;

const p=document.createElement("p");

p.textContent=desc;

box.append(heading,p);

burst();

}

/* FLOATING HEARTS */

function burst(){

const field=document.getElementById("heartfield");

const symbols=[

"💜","✨","🌸","💕","⭐","🦋"

];

for(let i=0;i<26;i++){

const el=document.createElement("span");

el.className="floaty";

el.textContent=

symbols[Math.floor(Math.random()*symbols.length)];

el.style.left=Math.random()*100+"%";

el.style.animationDelay=

Math.random()*.8+"s";

el.style.fontSize=

(15+Math.random()*18)+"px";

field.appendChild(el);

setTimeout(()=>el.remove(),5600);

}

}

/* ORIGINAL BACKGROUND MUSIC */

let audio=null;

let playing=false;

let sequenceTimer=null;

let noteIndex=0;

const melody=[

523.25,659.25,783.99,659.25,

587.33,698.46,880,698.46,

523.25,659.25,783.99,1046.5,

880,783.99,659.25,587.33

];

async function toggleMusic(){

if(playing){

stopMusic();

return;

}

try{

const AC=

window.AudioContext||window.webkitAudioContext;

if(!AC){

alert("Audio is not supported in this browser.");

return;

}

audio=new AC();

await audio.resume();

playing=true;

document.getElementById("musicBtn").textContent=

"♫ Pause music";

playNote();

}catch(err){

stopMusic();

document.getElementById("musicBtn").textContent=

"Music unavailable";

}

}

function playNote(){

if(!playing||!audio)return;

const now=audio.currentTime;

const freq=melody[noteIndex%melody.length];

const osc=audio.createOscillator();

const gain=audio.createGain();

osc.type="sine";

osc.frequency.setValueAtTime(freq,now);

gain.gain.setValueAtTime(.0001,now);

gain.gain.exponentialRampToValueAtTime(

.045,now+.08

);

gain.gain.exponentialRampToValueAtTime(

.0001,now+1.15

);

osc.connect(gain);

gain.connect(audio.destination);

osc.start(now);

osc.stop(now+1.2);

const bass=audio.createOscillator();

const bg=audio.createGain();

bass.type="sine";

bass.frequency.value=freq/2;

bg.gain.setValueAtTime(.0001,now);

bg.gain.exponentialRampToValueAtTime(

.012,now+.12

);

bg.gain.exponentialRampToValueAtTime(

.0001,now+1.5

);

bass.connect(bg);

bg.connect(audio.destination);

bass.start(now);

bass.stop(now+1.55);

noteIndex++;

sequenceTimer=setTimeout(playNote,780);

}

function stopMusic(){

playing=false;

if(sequenceTimer){

clearTimeout(sequenceTimer);

sequenceTimer=null;

}

if(audio){

audio.close();

audio=null;

}

document.getElementById("musicBtn").textContent=

"♫ Play soft music";

}

/* STOP MUSIC WHEN TAB IS HIDDEN */

document.addEventListener(

"visibilitychange",

()=>{

if(document.hidden&&playing){

stopMusic();

}

}

);

</script>

